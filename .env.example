# Copy to .env (never commit .env). Values below are placeholders for LOCAL use only.
SQL_SA_PASSWORD=Change_Me_Str0ng!Passw0rd
RABBITMQ_USER=guest
RABBITMQ_PASSWORD=guest
# 32 random bytes, base64. Generate: openssl rand -base64 32   (or: [Convert]::ToBase64String((1..32 | % { Get-Random -Max 256 })) )
SECURITY_MASTER_KEY=REPLACE_WITH_BASE64_32_BYTES
SECURITY_PEPPER=REPLACE_WITH_LONG_RANDOM_STRING
BOOTSTRAP_ADMIN_EMAIL=admin@jobplatform.local
BOOTSTRAP_ADMIN_MOBILE=+970590000000
BOOTSTRAP_ADMIN_PASSWORD=Change_Me_Adm1n!Passw0rd
SERVICE_CLIENT_ID=svc-local
SERVICE_CLIENT_SECRET=REPLACE_WITH_LONG_RANDOM_STRING

# Optional: OTLP endpoint of a collector (traces + metrics); leave empty to keep telemetry in-process only.
OTEL_EXPORTER_OTLP_ENDPOINT=
