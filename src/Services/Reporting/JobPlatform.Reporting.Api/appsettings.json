{
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": { "Microsoft.AspNetCore": "Warning", "Microsoft.EntityFrameworkCore": "Warning", "System": "Warning" }
    },
    "WriteTo": [
      { "Name": "Console", "Args": { "formatter": "Serilog.Formatting.Compact.CompactJsonFormatter, Serilog.Formatting.Compact" } }
    ]
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "Reporting": "Server=IT-Akash;Database=JobPlatform_Reporting;Integrated Security=True;TrustServerCertificate=True"
  },
  "Database": { "Provider": "SqlServer", "ApplyMigrationsOnStartup": false },
  "Cache": { "Provider": "Redis", "ConnectionString": "redis:6379", "KeyPrefix": "prod:reporting" },
  "Messaging": {
    "Provider": "RabbitMq",
    "RabbitMq": {
      "HostName": "rabbitmq",
      "Port": 5672,
      "UserName": "guest",
      "Password": "REPLACE_WITH_SECRET",
      "VirtualHost": "/",
      "Exchange": "jobplatform.reporting.events"
    }
  },
  "Outbox": { "BatchSize": 20, "PollInterval": "00:00:01", "MaxAttempts": 10, "Enabled": true },
  "Inbox": { "BatchSize": 20, "PollInterval": "00:00:01", "MaxAttempts": 5, "Enabled": true },
  "Jwt": {
    "Issuer": "https://identity.jobplatform.local",
    "Audience": "jobplatform",
    "JwksUri": "http://account-identity-api:8080/.well-known/jwks.json"
  },
  "Authorization": { "PermissionMode": "AdministratorImplicit" },
  "RateLimiting": { "Global": { "PermitLimit": 600 }, "Public": { "PermitLimit": 120 } },
  "Telemetry": { "Enabled": true, "Otlp": { "Endpoint": "" } },
  "Reporting": {
    "MinSampleSize": 10,
    "MinCell": 5,
    "LegalMinimumRetentionMonths": 6,
    "ActorKeySalt": "REPLACE_WITH_SECRET",
    "LinkSigningKey": "REPLACE_WITH_SECRET",
    "PublicBaseUrl": "http://localhost:8080"
  },
  "Jobs": { "Enabled": true },
  "Metrics": { "Provider": "Prometheus", "Prometheus": { "BaseUrl": "", "Queries": {} } },
  "Sessions": { "Provider": "Http" },
  "Identity": { "BaseUrl": "http://account-identity-api:8080", "ClientId": "svc-local", "ClientSecret": "REPLACE_WITH_SECRET" },
  "PowerBi": { "Provider": "Http", "BaseUrl": "https://api.powerbi.com/v1.0/myorg", "AccessToken": "REPLACE_WITH_SECRET" },
  "Swagger": { "Enabled": false }
}