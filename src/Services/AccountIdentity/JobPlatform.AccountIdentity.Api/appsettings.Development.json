{
  "Serilog": {
    "MinimumLevel": {
      "Default": "Debug",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning",
        "System": "Warning"
      }
    },
    "WriteTo": [
      { "Name": "Console" }
    ]
  },
  "ConnectionStrings": {
    "Identity": "Data Source=identity-dev.db"
  },
  "Database": {
    "Provider": "Sqlite"
  },
  "Cache": {
    "Provider": "InMemory",
    "KeyPrefix": "dev:account-identity"
  },
  "Messaging": {
    "Provider": "InMemory"
  },
  "Security": {
    "MasterKey": "ZGV2LW9ubHktbWFzdGVyLWtleS0zMi1ieXRlcyEhISE=",
    "Pepper": "dev-only-pepper-change-me",
    "Pbkdf2Iterations": 100000
  },
  "Bootstrap": {
    "AdminEmail": "admin@jobplatform.local",
    "AdminMobile": "+970590000000",
    "AdminName": "Dev Administrator",
    "AdminPassword": "Adm1n!Passw0rd-dev"
  },
  "ServiceClients": {
    "Clients": [
      { "ClientId": "svc-dev", "Secret": "dev-service-secret-change-me" }
    ]
  },
  "Delivery": {
    "Provider": "Log",
    "LogCodesInDevelopment": true
  },
  "Swagger": {
    "Enabled": true
  }
}
