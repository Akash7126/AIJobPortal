{
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning",
        "System": "Warning"
      }
    },
    "WriteTo": [
      {
        "Name": "Console",
        "Args": { "formatter": "Serilog.Formatting.Compact.CompactJsonFormatter, Serilog.Formatting.Compact" }
      }
    ]
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "Identity": "Server=IT-Akash;Database=JobPlatform_AccountIdentity;Integrated Security=True;TrustServerCertificate=True"
  },
  "Database": {
    "Provider": "SqlServer",
    "ApplyMigrationsOnStartup": false
  },
  "Cache": {
    "Provider": "Redis",
    "ConnectionString": "redis:6379",
    "KeyPrefix": "prod:account-identity"
  },
  "Messaging": {
    "Provider": "RabbitMq",
    "RabbitMq": {
      "HostName": "rabbitmq",
      "Port": 5672,
      "UserName": "guest",
      "Password": "REPLACE_WITH_SECRET",
      "VirtualHost": "/",
      "Exchange": "jobplatform.account-identity.events"
    }
  },
  "Outbox": {
    "BatchSize": 20,
    "PollInterval": "00:00:01",
    "MaxAttempts": 10,
    "Enabled": true
  },
  "Jwt": {
    "Issuer": "https://identity.jobplatform.local",
    "Audience": "jobplatform",
    "AccessTokenMinutes": 15
  },
  "Security": {
    "MasterKey": "",
    "Pepper": "",
    "Pbkdf2Iterations": 210000
  },
  "Bootstrap": {
    "AdminEmail": "",
    "AdminMobile": "",
    "AdminName": "Platform Administrator",
    "AdminPassword": ""
  },
  "ServiceClients": {
    "Clients": []
  },
  "Delivery": {
    "Provider": "Log",
    "LogCodesInDevelopment": false
  },
  "Consent": {
    "CurrentPolicyVersion": "2026-01",
    "PrivacyPolicyUrl": "/privacy-policy"
  },
  "RateLimiting": {
    "Global": { "PermitLimit": 600 },
    "Auth": { "PermitLimit": 30 }
  },
  "AccessLog": {
    "RetentionDays": 365,
    "Enabled": true
  },
  "Telemetry": {
    "Enabled": true,
    "Otlp": { "Endpoint": "" }
  },
  "Swagger": {
    "Enabled": false
  }
}
