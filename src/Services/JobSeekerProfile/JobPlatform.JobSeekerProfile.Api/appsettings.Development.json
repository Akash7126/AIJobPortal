{
  "Serilog": {
    "MinimumLevel": {
      "Default": "Debug",
      "Override": { "Microsoft.AspNetCore": "Warning", "Microsoft.EntityFrameworkCore": "Warning", "System": "Warning" }
    },
    "WriteTo": [ { "Name": "Console" } ]
  },
  "ConnectionStrings": { "JobSeekerProfile": "Data Source=job-seeker-profile-dev.db" },
  "Database": { "Provider": "Sqlite" },
  "Cache": { "Provider": "InMemory", "KeyPrefix": "dev:job-seeker-profile" },
  "Messaging": { "Provider": "InMemory" },
  "Jwt": { "JwksUri": "http://localhost:5100/.well-known/jwks.json" },
  "Api": { "PublicBaseUrl": "http://localhost:5104" },
  "FileStorage": { "Provider": "Local", "LocalPath": "./file-storage" },
  "AccountIdentity": { "Provider": "Fake" },
  "Swagger": { "Enabled": true }
}