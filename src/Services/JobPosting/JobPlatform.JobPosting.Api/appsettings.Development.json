{
  "Serilog": {
    "MinimumLevel": {
      "Default": "Debug",
      "Override": { "Microsoft.AspNetCore": "Warning", "Microsoft.EntityFrameworkCore": "Warning", "System": "Warning" }
    },
    "WriteTo": [ { "Name": "Console" } ]
  },
  "ConnectionStrings": { "JobPosting": "Server=IT-Akash;Database=JobPlatform_JobPosting;Integrated Security=True;TrustServerCertificate=True" },
  "Database": { "Provider": "SqlServer", "ApplyMigrationsOnStartup": true },
  "Cache": { "Provider": "InMemory", "KeyPrefix": "dev:job-posting" },
  "Messaging": { "Provider": "InMemory" },
  "Jwt": { "JwksUri": "http://localhost:5100/.well-known/jwks.json" },
  "Swagger": { "Enabled": true }
}